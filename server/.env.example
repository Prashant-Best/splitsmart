NODE_ENV=development
PORT=4000

# `npm run db` starts a single-node replica set here (transactions need a replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/splitsmart?directConnection=true

# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Where the React app runs (CORS) and the base URL used in emails
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Receipts are stored on local disk
UPLOAD_DIR=uploads
MAX_RECEIPT_MB=5

# Email. Leave SMTP_URL empty to save emails as HTML files in .outbox/ instead of sending them.
# Docker Compose points this at Mailpit (http://localhost:8025).
SMTP_URL=
MAIL_FROM=SplitSmart <reminders@splitsmart.local>

# Weekly reminder emails (cron syntax). Empty disables the scheduler.
REMINDERS_CRON=0 9 * * 1
REMINDERS_TZ=Asia/Kolkata
